def _offline_places(destination):
    key = re.sub(r"[^a-z]", "", clean_text(destination).casefold())
    aliases = {
        "mysuru": "mysore", "ootacamund": "ooty",
        "visakhapatnamcity": "visakhapatnam", "vizag": "visakhapatnam",
        "newdelhi": "delhi", "tirupati": "tirumala",
    }
    key = aliases.get(key, key)
    records = _OFFLINE_ATTRACTIONS.get(key)
    if not records:
        # Permit common suffixes such as "Hyderabad, Telangana".
        for city, values in _OFFLINE_ATTRACTIONS.items():
            if key.startswith(city) or city.startswith(key):
                records = values
                break
    if not records:
        return None
    return {
        "destination": clean_text(destination),
        "places": [
            {
                "id": f"offline:{key}:{index}",
                "name": name,
                "category": category,
                "latitude": None,
                "longitude": None,
                "image": "",
                "description": f"{name} is a popular attraction in {clean_text(destination)}.",
                "opening_hours": "",
                "website": "",
                "wikipedia_url": None,
                "map_url": f"https://www.google.com/maps/search/?api=1&query={quote(name + ' ' + clean_text(destination))}",
                "source": "Curated offline fallback catalogue",
            }
            for index, (name, category) in enumerate(records, start=1)
        ],
        "source": "Curated offline fallback catalogue",
        "cached": True,
    }


# Cache successful place searches for 24 hours.
PLACE_CACHE_TTL = 24 * 60 * 60
_PLACE_CACHE = {}
_CACHE_FILE = __import__("pathlib").Path(__file__).resolve().parents[2] / "instance" / "places_cache.json"
try:
    if _CACHE_FILE.exists():
        _PLACE_CACHE.update(__import__("json").loads(_CACHE_FILE.read_text(encoding="utf-8")))
except Exception as cache_error:
    print("PLACE CACHE READ ERROR:", cache_error)

def _persist_place_cache():
    try:
        _CACHE_FILE.parent.mkdir(parents=True, exist_ok=True)
        temp = _CACHE_FILE.with_suffix(".tmp")
        temp.write_text(__import__("json").dumps(_PLACE_CACHE, ensure_ascii=False), encoding="utf-8")
        temp.replace(_CACHE_FILE)
    except Exception as cache_error:
        print("PLACE CACHE WRITE ERROR:", cache_error)



def search_places(destination):
    """Return cached places when available and fall back to
    cached results if OpenStreetMap temporarily fails.
    """
    destination = clean_text(destination)

    if not destination:
        raise ValueError("Please provide a destination.")

    cache_key = destination.casefold()
    now = time.time()

    # For supported Indian cities, return the curated catalogue immediately.
    # This avoids repeated Nominatim/Overpass outages blocking the planning page.
    instant_fallback = _offline_places(destination)
    if instant_fallback:
        cached_now = _PLACE_CACHE.get(cache_key)
        if cached_now and now - cached_now.get("saved_at", 0) < PLACE_CACHE_TTL:
            return deepcopy(cached_now["result"])
        _PLACE_CACHE[cache_key] = {
            "saved_at": now,
            "result": deepcopy(instant_fallback),
        }
        _persist_place_cache()
        print(f"INSTANT OFFLINE PLACE CATALOGUE: {destination}")
        return instant_fallback

    cached = _PLACE_CACHE.get(cache_key)

    # Use fresh cached results without contacting external APIs.
    if cached and now - cached["saved_at"] < PLACE_CACHE_TTL:
        print(f"PLACE CACHE HIT: {destination}")
        return deepcopy(cached["result"])

    try:
        result = _search_places_uncached(destination)

        # If OSM has no mapped attractions, prefer the offline catalogue
        # over caching an empty result for the user.
        if not result.get("places"):
            fallback = _offline_places(destination)
            if fallback:
                result = fallback

        # Cache successful results.
        _PLACE_CACHE[cache_key] = {
            "saved_at": time.time(),
            "result": deepcopy(result),
        }

        _persist_place_cache()
        print(f"PLACE CACHE UPDATED: {destination}")
        return result

    except Exception as error:
        # If the external services fail, reuse older cached results.
        if cached:
            print(
                f"PLACE CACHE FALLBACK: {destination}. "
                f"External search failed: {error}"
            )
            return deepcopy(cached["result"])

        # No previous results: use a curated offline fallback for supported
        # Indian destinations instead of showing an empty error panel.
        fallback = _offline_places(destination)
        if fallback:
            _PLACE_CACHE[cache_key] = {
                "saved_at": time.time(),
                "result": deepcopy(fallback),
            }
            _persist_place_cache()
            print(f"OFFLINE PLACE FALLBACK: {destination}")
            return fallback
        raise



def get_place_details(place_id):
    match = re.fullmatch(
        r"(node|way|relation)/(\d+)",
        clean_text(place_id)
    )

    if not match:
        raise ValueError("Invalid place identifier.")

    osm_type, osm_id = match.groups()

    query = f"""
    [out:json][timeout:15];
    {osm_type}({osm_id});
    out center tags;
    """

    result = get_overpass_data(query, timeout=20)
    elements = result.get("elements", [])

    if not elements:
        raise LookupError("This place could not be found.")

    element = elements[0]
    tags = element.get("tags") or {}

    name = clean_text(tags.get("name") or tags.get("name:en"))

    wikipedia_title = tags.get("wikipedia", "")

    if wikipedia_title.lower().startswith("en:"):
        wikipedia_title = wikipedia_title[3:]

    wiki = wikipedia_information(wikipedia_title)

    center = element.get("center") or {}

    latitude = element.get("lat", center.get("lat"))
    longitude = element.get("lon", center.get("lon"))

    category = (
        tags.get("tourism")
        or tags.get("historic")
        or tags.get("amenity")
        or tags.get("leisure")
        or tags.get("natural")
        or "Place"
    ).replace("_", " ").title()

    return {
        "id": place_id,
        "name": name,
        "category": category,
        "description": (
            wiki.get("description")
            or clean_text(tags.get("description"))
        ),
        "image": tags.get("image") or wiki.get("image"),
        "opening_hours": clean_text(tags.get("opening_hours")),
        "website": tags.get("website") or tags.get("contact:website"),
        "wikipedia_url": wiki.get("wikipedia_url"),
        "latitude": latitude,
        "longitude": longitude,
        "map_url": (
            "https://www.openstreetmap.org/"
            f"?mlat={latitude}&mlon={longitude}"
            if latitude is not None and longitude is not None
            else None
        ),
        "history": (
            "No verified historical information was available "
            "from the connected sources."
        ),
        "source": "OpenStreetMap contributors",
    }