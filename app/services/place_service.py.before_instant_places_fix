import re
import time
from copy import deepcopy
import requests
from urllib.parse import quote


OVERPASS_URLS = [
    "https://overpass-api.de/api/interpreter",
    "https://overpass.kumi.systems/api/interpreter",
    "https://overpass.private.coffee/api/interpreter",
]

HEADERS = {
    "User-Agent": "AITravelTourismStudentProject/1.0 (Flask travel project)"
}

SESSION = requests.Session()
SESSION.headers.update(HEADERS)


def clean_text(value):
    return re.sub(r"\s+", " ", str(value or "")).strip()


def wikipedia_information(title):
    if not title:
        return {}

    try:
        url = (
            "https://en.wikipedia.org/api/rest_v1/page/summary/"
            + quote(title.replace(" ", "_"), safe="()_,.-")
        )

        response = SESSION.get(url, timeout=(2, 4))
        response.raise_for_status()
        data = response.json()

        if data.get("type") == "disambiguation":
            return {}

        return {
            "description": clean_text(data.get("extract")),
            "image": (
                (data.get("thumbnail") or {}).get("source")
                or (data.get("originalimage") or {}).get("source")
            ),
            "wikipedia_url": (
                (data.get("content_urls") or {})
                .get("desktop", {})
                .get("page")
            ),
        }

    except (requests.RequestException, ValueError) as error:
        print("WIKIPEDIA LOOKUP ERROR:", error)
        return {}


def get_overpass_data(query, timeout=30):
    """Try several Overpass servers and report their actual errors."""

    for endpoint in OVERPASS_URLS:
        try:
            print("Trying Overpass endpoint:", endpoint)

            response = SESSION.post(
                endpoint,
                data={"data": query},
                timeout=(1, 2)
            )

            response.raise_for_status()
            return response.json()

        except (requests.RequestException, ValueError) as error:
            print(f"OVERPASS ERROR [{endpoint}]: {error}")

    raise RuntimeError(
        "All Overpass servers failed. Check the terminal for details."
    )


def find_destination(destination):
    response = SESSION.get(
        "https://nominatim.openstreetmap.org/search",
        params={
            "q": destination,
            "format": "jsonv2",
            "limit": 1,
            "countrycodes": "in",
        },
        timeout=(1, 3)
    )

    response.raise_for_status()
    locations = response.json()

    if not locations:
        return None

    return locations[0]


def _search_places_uncached(destination):
    destination = clean_text(destination)

    if not destination:
        raise ValueError("Please provide a destination.")

    location = find_destination(destination)

    if not location:
        return {
            "destination": destination,
            "places": [],
            "source": "OpenStreetMap contributors",
        }

    latitude = float(location["lat"])
    longitude = float(location["lon"])

    query = f"""
    [out:json][timeout:25];
    (
      nwr(around:12000,{latitude},{longitude})
          ["tourism"~"attraction|museum|viewpoint|artwork|zoo|gallery"];
      nwr(around:12000,{latitude},{longitude})["historic"];
      nwr(around:12000,{latitude},{longitude})
          ["amenity"="place_of_worship"];
      nwr(around:12000,{latitude},{longitude})
          ["leisure"~"park|nature_reserve|garden"];
      nwr(around:12000,{latitude},{longitude})
          ["natural"~"peak|waterfall|cave|beach"];
    );
    out center tags;
    """

    result = get_overpass_data(query)

    places = []
    seen_names = set()

    for element in result.get("elements", []):
        tags = element.get("tags") or {}

        name = clean_text(tags.get("name") or tags.get("name:en"))

        if not name or name.casefold() in seen_names:
            continue

        center = element.get("center") or {}

        place_lat = element.get("lat", center.get("lat"))
        place_lon = element.get("lon", center.get("lon"))

        if place_lat is None or place_lon is None:
            continue

        seen_names.add(name.casefold())

        category = (
            tags.get("tourism")
            or tags.get("historic")
            or tags.get("amenity")
            or tags.get("leisure")
            or tags.get("natural")
            or "Place"
        ).replace("_", " ").title()

        wikipedia_title = tags.get("wikipedia", "")

        if wikipedia_title.lower().startswith("en:"):
            wikipedia_title = wikipedia_title[3:]

        # Use metadata already present in OpenStreetMap. Wikipedia is queried
        # only on demand from the details panel, never serially for every card.
        wiki = {}

        places.append({
            "id": f'{element["type"]}/{element["id"]}',
            "name": name,
            "category": category,
            "latitude": float(place_lat),
            "longitude": float(place_lon),
            "image": tags.get("image") or wiki.get("image"),
            "description": (
                wiki.get("description")
                or clean_text(tags.get("description"))
            ),
            "opening_hours": clean_text(tags.get("opening_hours")),
            "website": tags.get("website") or tags.get("contact:website"),
            "wikipedia_url": wiki.get("wikipedia_url"),
            "map_url": (
                "https://www.openstreetmap.org/"
                f"?mlat={place_lat}&mlon={place_lon}"
                f"#map=17/{place_lat}/{place_lon}"
            ),
            "source": "OpenStreetMap contributors",
        })

    # Show places with real image URLs first.
    places.sort(
        key=lambda place: (
            not bool(place["image"]),
            place["name"].casefold()
        )
    )

    return {
        "destination": destination,
        "places": places[:30],
        "source": "OpenStreetMap contributors",
    }



